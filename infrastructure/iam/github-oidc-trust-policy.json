{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::210452150784:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": [
            "sts.amazonaws.com",
            "https://github.com/subasangeeth"
          ]
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:subasangeeth/employee-document-vault:*",
            "repo:Subasangeeth/employee-document-vault:*",
            "repo:*:employee-document-vault:*"
          ]
        }
      }
    }
  ]
}
